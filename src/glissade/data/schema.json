{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://glissade.dev/schema/v1.json",
  "x-glissade-schema": 1,
  "x-glissade-version": "2026.11.1.1",
  "title": "Glissade deck",
  "description": "A presentation deck. Either an object with metadata and a slides array, or a bare array of slides.",
  "oneOf": [
    {
      "$ref": "#/$defs/deckObject"
    },
    {
      "type": "array",
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  ],
  "$defs": {
    "deckObject": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "glissade": {
          "type": "string",
          "description": "Minimum Glissade version this deck needs, e.g. \">=2026.11.1\". Older versions warn rather than rendering it incompletely.",
          "examples": [
            ">=2026.11.1",
            ">=2026.11.1,<2027"
          ]
        },
        "format": {
          "type": "integer",
          "description": "The deck format this was written against. Absent means 1. Recorded so a future release can migrate the file rather than guess.",
          "default": 1,
          "examples": [
            1
          ]
        },
        "title": {
          "type": "string",
          "description": "Shown in the deck picker and browser tab."
        },
        "subtitle": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "description": "Sort position in the picker. Lower first."
        },
        "slides": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slide"
          }
        },
        "theme": {
          "description": "The theme this deck opens in: an id from `glissade themes`, or a theme defined right here so the deck carries its own look. The presenter can still switch with T or from the remote.",
          "oneOf": [
            {
              "type": "string",
              "examples": [
                "paper",
                "parchment"
              ]
            },
            {
              "$ref": "#/$defs/deckTheme"
            }
          ]
        }
      },
      "required": [
        "slides"
      ],
      "additionalProperties": false
    },
    "slide": {
      "type": "object",
      "properties": {
        "n": {
          "type": "integer",
          "description": "Slide number. Informational; order comes from array position."
        },
        "title": {
          "type": "string",
          "description": "Short label for the remote's jump list. Not shown on the slide."
        },
        "layout": {
          "enum": [
            "title",
            "title-content",
            "section",
            "title-only",
            "two-content",
            "comparison",
            "content-caption",
            "picture-caption",
            "media-right",
            "media-left",
            "media-full",
            "media-caption",
            "grid",
            "quad-chart",
            "cards",
            "quote",
            "blank"
          ],
          "default": "blank",
          "description": "Omit or use 'blank' to render raw `html`. 'cards' shows two to four `cards` side by side; 'quote' shows a large `quote` beside an optional panel or image."
        },
        "cls": {
          "type": "string",
          "description": "Space-separated modifiers: 'ask' (dark, for questions), 'story', 'center'."
        },
        "tag": {
          "type": "string",
          "description": "Small label in the slide corner."
        },
        "eyebrow": {
          "type": "string"
        },
        "heading": {
          "type": "string"
        },
        "subheading": {
          "type": "string"
        },
        "byline": {
          "type": "string",
          "description": "Title layout only."
        },
        "body": {
          "type": "string",
          "description": "HTML allowed."
        },
        "bullets": {
          "$ref": "#/$defs/bullets"
        },
        "quote": {
          "type": "string"
        },
        "cite": {
          "type": "string"
        },
        "quoteBig": {
          "type": "boolean"
        },
        "caption": {
          "type": "string",
          "description": "content-caption layout: the narrow text column."
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "media": {
          "$ref": "#/$defs/media"
        },
        "images": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/image"
          },
          "description": "grid layout only. Two to four images."
        },
        "left": {
          "$ref": "#/$defs/block"
        },
        "right": {
          "$ref": "#/$defs/block"
        },
        "quads": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/quad"
          },
          "description": "quad-chart layout only. Exactly four quadrants, each with its own subheading and text or media content."
        },
        "aspect": {
          "type": "string"
        },
        "html": {
          "type": "string",
          "description": "blank layout only: raw markup, used verbatim."
        },
        "callout": {
          "type": "string",
          "description": "HTML allowed. The takeaway: a filled box that always renders last on the slide. Keep it to one or two sentences."
        },
        "source": {
          "type": "string",
          "description": "HTML allowed. A small citation line pinned to the foot of the slide."
        },
        "cards": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/card"
          },
          "description": "cards layout only. Two to four parallel ideas, shown side by side."
        },
        "numbered": {
          "type": "boolean",
          "description": "cards layout: number the cards (renders an ordered list)."
        },
        "scrim": {
          "enum": [
            "bottom",
            "left",
            "none"
          ],
          "default": "bottom",
          "description": "media-full layout: where the darkening behind the text sits. 'left' suits a subject on the right of the image."
        },
        "notes": {
          "type": "string",
          "description": "Speaker notes. HTML allowed. Shown on the phone and with N on screen."
        }
      },
      "additionalProperties": false
    },
    "bullets": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "text": {
                "type": "string"
              },
              "sub": {
                "type": "string"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "image": {
      "type": "object",
      "description": "A local image. The path is relative to this deck file and the image is embedded into the built HTML.",
      "properties": {
        "src": {
          "type": "string",
          "description": "Path relative to the deck file, e.g. media/images/chart.png"
        },
        "alt": {
          "type": "string",
          "description": "What the image shows, for people who can't see it. Use \"\" only for pure decoration."
        },
        "fit": {
          "enum": [
            "contain",
            "cover"
          ],
          "default": "contain"
        },
        "caption": {
          "type": "string",
          "description": "HTML allowed"
        },
        "focus": {
          "type": "string",
          "description": "Where a cropped (cover) image anchors: CSS object-position, e.g. 'center top', 'right', '70% 30%'.",
          "examples": [
            "center top",
            "right center",
            "70% 30%"
          ]
        }
      },
      "required": [
        "src"
      ],
      "additionalProperties": false
    },
    "media": {
      "type": "object",
      "description": "An iframe. Use `file` for a local activity (works offline), or `src` for an external page (needs the network).",
      "properties": {
        "file": {
          "type": "string",
          "description": "Local .html, inlined as srcdoc. Offline-safe."
        },
        "srcdoc": {
          "type": "string",
          "description": "Inline HTML. Offline-safe."
        },
        "src": {
          "type": "string",
          "description": "External URL. NEEDS LIVE INTERNET. For YouTube use the /embed/ form."
        },
        "aspect": {
          "type": "string",
          "description": "'16:9', '4:3', or 'auto' to fill the region. Omit for the per-kind default."
        },
        "sandbox": {
          "type": "string"
        },
        "allow": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "description": "One side of a two-content or comparison slide. Text, an image, or an embed.",
      "properties": {
        "subheading": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "bullets": {
          "$ref": "#/$defs/bullets"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "media": {
          "$ref": "#/$defs/media"
        },
        "aspect": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "quad": {
      "type": "object",
      "description": "One quadrant of a quad-chart slide. Give it a subheading and either text fields or an image/embed.",
      "properties": {
        "subheading": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "bullets": {
          "$ref": "#/$defs/bullets"
        },
        "image": {
          "$ref": "#/$defs/image"
        },
        "media": {
          "$ref": "#/$defs/media"
        },
        "aspect": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "card": {
      "type": "object",
      "description": "One card on a cards slide: a short title, a line or two of body, an optional source and image.",
      "properties": {
        "title": {
          "type": "string",
          "description": "A few words. HTML allowed."
        },
        "body": {
          "type": "string",
          "description": "HTML allowed. One or two sentences."
        },
        "source": {
          "type": "string",
          "description": "HTML allowed. A scripture reference, author or citation, shown at the foot of the card."
        },
        "image": {
          "$ref": "#/$defs/image"
        }
      },
      "additionalProperties": false
    },
    "deckTheme": {
      "type": "object",
      "description": "A theme defined inside the deck. Layers, each winning over the last: the theme it extends, then palette, then vars.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Shown in the theme picker as \"<name> (this deck)\". Defaults to the deck title."
        },
        "description": {
          "type": "string"
        },
        "extends": {
          "type": "string",
          "description": "Start from this theme id (a built-in or one from the project's themes.json).",
          "examples": [
            "paper",
            "slate"
          ]
        },
        "palette": {
          "type": "object",
          "description": "Shorthand: every colour token is derived from these, with text pushed to WCAG AA contrast.",
          "properties": {
            "dark": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            },
            "light": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            },
            "accent2": {
              "type": "string",
              "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$"
            },
            "display_font": {
              "type": "string",
              "description": "CSS font stack for headings."
            },
            "body_font": {
              "type": "string",
              "description": "CSS font stack for body text."
            }
          },
          "additionalProperties": false
        },
        "vars": {
          "type": "object",
          "description": "Individual CSS custom properties, e.g. {\"--card-bg\": \"#ffffff\"}. Win over the palette.",
          "propertyNames": {
            "pattern": "^--"
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "family",
              "src"
            ],
            "properties": {
              "family": {
                "type": "string",
                "description": "The name to use in --display-font / --body-font or palette fonts."
              },
              "src": {
                "type": "string",
                "description": "Font file (.woff2, .woff, .ttf, .otf), relative to the deck file. Embedded, so it works offline."
              },
              "weight": {
                "type": [
                  "string",
                  "number"
                ],
                "description": "CSS font-weight this file provides, e.g. 400 or \"700\"."
              },
              "style": {
                "type": "string",
                "enum": [
                  "normal",
                  "italic"
                ]
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "examples": [
        {
          "extends": "paper",
          "name": "Q3 Review",
          "palette": {
            "dark": "#1b2a41",
            "light": "#f7f4ee",
            "accent": "#c8553d"
          }
        }
      ]
    }
  }
}
